{
  "name": "xml-helper",
  "displayName": "XML Helper",
  "description": "VS Code extension to close XML tags and insert XML templates.",
  "version": "1.0.0",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "icon": "images/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:xml",
    "onLanguage:html"
  ],
  "contributes": {
    "commands": [
      {
        "command": "xmlHelper.closeCurrentTag",
        "title": "Close Current XML Tag",
        "category": "XML"
      },
      {
        "command": "xmlHelper.insertSnippet1",
        "title": "Insert XML Snippet 1",
        "category": "XML"
      },
      {
        "command": "xmlHelper.insertSnippet2",
        "title": "Insert XML Snippet 2",
        "category": "XML"
      },
      {
        "command": "xmlHelper.insertCustomTemplate",
        "title": "Insert Custom XML Template",
        "category": "XML"
      },
      {
        "command": "xmlHelper.addCustomTemplate",
        "title": "Add Custom XML Template",
        "category": "XML"
      }
    ],
    "keybindings": [
      {
        "key": "ctrl+shift+q",
        "command": "xmlHelper.closeCurrentTag",
        "when": "editorTextFocus && (editorLangId == 'xml' || editorLangId == 'html')"
      },
      {
        "key": "ctrl+shift+1",
        "command": "xmlHelper.insertSnippet1",
        "when": "editorTextFocus && (editorLangId == 'xml' || editorLangId == 'html')"
      },
      {
        "key": "ctrl+shift+2",
        "command": "xmlHelper.insertSnippet2",
        "when": "editorTextFocus && (editorLangId == 'xml' || editorLangId == 'html')"
      }
    ],
    "configuration": {
      "title": "XML Helper",
      "properties": {
        "xmlHelper.templates": {
          "type": "array",
          "default": [],
          "description": "Custom XML templates",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Template name"
              },
              "content": {
                "type": "string",
                "description": "XML content"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.82.0",
    "typescript": "^4.9.5",
    "vscode-test": "^1.6.1"
  },
  "dependencies": {
    "xml-helper": "file:"
  }
}
