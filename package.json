{
  "name": "epsilon-tag-closer",
  "displayName": "Epsilon Tag Closer",
  "description": "Automatically closes epsilon tags when pressing Ctrl+Shift+Q",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:epsilon-tag-closer.closeEpsilonTag"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "epsilon-tag-closer.closeEpsilonTag",
        "title": "Close Epsilon Tag"
      }
    ],
    "keybindings": [
      {
        "command": "epsilon-tag-closer.closeEpsilonTag",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc",
    "watch": "tsc -watch",
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "eslint": "^8.1.0",
    "glob": "^7.1.7",
    "mocha": "^9.1.3",
    "typescript": "^4.4.4"
  },
  "dependencies": {
    "epsilon-tag-closer": "file:"
  }
}
